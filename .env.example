# Set to 1 to run the cockpit in mock mode (no real Anthropic SDK calls).
# Mock mode replays fixture JSONL files from ./mocks/sessions/ to exercise
# all six tile states.
COCKPIT_MOCK=0

# Orchestrator listens for websocket upgrades on this port (same port as
# Next, so typically left alone).
COCKPIT_PORT=3000

# Optional — used only when COCKPIT_MOCK=0 to hit the Anthropic API.
# ANTHROPIC_API_KEY=
