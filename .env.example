# Set to 1 to run the cockpit in mock mode (no real Anthropic SDK calls).
# Mock mode replays fixture JSONL files from ./mocks/sessions/ to exercise
# all six tile states.
COCKPIT_MOCK=0

# Orchestrator listens for websocket upgrades on this port (same port as
# Next, so typically left alone).
COCKPIT_PORT=3010

# Optional — used only when COCKPIT_MOCK=0 to hit the Anthropic API.
# ANTHROPIC_API_KEY=

# Optional — absolute path to the Claude Code CLI. Set this when the binary
# lives outside the auto-discovered locations (~/.local/bin/claude,
# /usr/local/bin/claude, /opt/homebrew/bin/claude). Useful when launching
# the cockpit from a context (launchd, GUI app) where PATH is restricted.
# CLAUDE_CLI_PATH=/Users/you/.local/bin/claude
